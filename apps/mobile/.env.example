# Safe to ship in the app (EXPO_PUBLIC_ values are readable by anyone who installs it): the Supabase project URL and the
# publishable (anon) key. Never put the service-role key, the email key or any other secret here.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# The address of the deployed web app, where /api/push and /api/food-search live (no trailing slash).
EXPO_PUBLIC_API_URL=https://your-app.vercel.app
