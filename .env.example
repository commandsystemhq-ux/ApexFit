# Browser (Vite) - safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel project settings, never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-app.vercel.app
TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Jack AI assistant (set one; OpenAI is used when both exist)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: openai or gemini, and a model name such as gpt-4o-mini or gemini-2.0-flash
JACK_PROVIDER=
JACK_MODEL=

# Live video sessions: Zoom Server-to-Server OAuth app (optional; without it coaches paste a Zoom/Meet link)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Program store: set to true to confirm paid orders instantly without Stripe (testing only, never in production)
STORE_DEMO_MODE=

# ApexFit Live room (built-in video calls): optional self-hosted or 8x8 Jitsi host, for example meet.example.com
VITE_JITSI_DOMAIN=
