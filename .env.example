# Browser (Vite) - safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel project settings, never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-app.vercel.app
TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Jack AI assistant (set one; OpenAI is used when both exist)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: openai or gemini, and a model name such as gpt-4o-mini or gemini-2.0-flash
JACK_PROVIDER=
JACK_MODEL=

# Live video sessions: Zoom Server-to-Server OAuth app (optional; without it coaches paste a Zoom/Meet link)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Program store: set to true to confirm paid orders instantly without Stripe (testing only, never in production)
STORE_DEMO_MODE=

# ApexFit Live room (native WebRTC): optional TURN relay for people behind strict firewalls or mobile networks
# Comma-separated list, for example turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# ---- Jack's AI provider: one choice for the whole platform (coaches, assistant trainers and clients all use it) ----
# Only the platform owner controls it, in two ways: these variables, and the /admin/ai screen (which can save a
# provider that then takes precedence; remove it there to go back to these variables).
# Comma-separated sign-in emails (confirmed addresses) that may open /admin/ai. Empty = nobody can.
PLATFORM_ADMIN_EMAILS=
# openai | gemini | azure_foundry | bedrock (empty = the first complete setup below)
# (OPENAI_API_KEY, GEMINI_API_KEY, JACK_PROVIDER and JACK_MODEL are described in the Jack section above.)

# Amazon Bedrock (JACK_PROVIDER=bedrock). IAM user with bedrock:InvokeModel and access to the model in that region.
# Model examples: anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-pro-v1:0
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Microsoft Azure AI Foundry (JACK_PROVIDER=azure_foundry).
# Endpoint example: https://my-resource.services.ai.azure.com (or https://my-resource.openai.azure.com)
# Deployment = the deployment / model name, e.g. gpt-4o, DeepSeek-R1, Llama-3.3-70B-Instruct (must support function calling)
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_DEPLOYMENT=
