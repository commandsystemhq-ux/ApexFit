# Browser (Vite) - safe to expose
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server only (Vercel project settings, never prefix with VITE_)
SUPABASE_SERVICE_ROLE_KEY=
APP_URL=https://your-app.vercel.app
TOKEN_ENCRYPTION_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PLATFORM_FEE_PERCENT=0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
CRON_SECRET=

# Jack AI assistant (set one; OpenAI is used when both exist)
OPENAI_API_KEY=
GEMINI_API_KEY=
# Optional: openai or gemini, and a model name such as gpt-4o-mini or gemini-2.0-flash
JACK_PROVIDER=
JACK_MODEL=

# Live video sessions: Zoom Server-to-Server OAuth app (optional; without it coaches paste a Zoom/Meet link)
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# Program store: set to true to confirm paid orders instantly without Stripe (testing only, never in production)
STORE_DEMO_MODE=

# ApexFit Live room (native WebRTC): optional TURN relay for people behind strict firewalls or mobile networks
# Comma-separated list, for example turn:turn.example.com:3478,turns:turn.example.com:5349
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Smart devices (optional, client Integrations page). Each pair turns that provider on; without it the card says "Not available".
# Needs APP_URL and TOKEN_ENCRYPTION_KEY above. Redirect address to register with the provider: <APP_URL>/api/wearables/<fitbit|oura|garmin>?action=callback
# Apple Health and MyFitnessPal files need no keys (they are read in the browser).
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=
# Garmin's Health API is for approved partners only (apply at developer.garmin.com)
GARMIN_CLIENT_KEY=
GARMIN_CLIENT_SECRET=
# Amazon Bedrock for Jack (optional; JACK_PROVIDER=bedrock selects it). The coach can instead enter these in Settings > AI provider.
# Needs an IAM user with bedrock:InvokeModel and access to the model in that region. Model example: anthropic.claude-3-5-sonnet-20241022-v2:0 or amazon.nova-pro-v1:0
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=

# Microsoft Azure AI Foundry for Jack (optional; JACK_PROVIDER=azure_foundry selects it). Also available in Settings > AI provider.
# Endpoint example: https://my-resource.services.ai.azure.com (or https://my-resource.openai.azure.com). Model = deployment name, e.g. gpt-4o, DeepSeek-R1, Llama-3.3-70B-Instruct
AZURE_FOUNDRY_ENDPOINT=
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_MODEL=